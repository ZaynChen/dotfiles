# XDG base directories
set -gx XDG_CONFIG_HOME $HOME/.config
set -gx XDG_CACHE_HOME $HOME/.cache
set -gx XDG_DATA_HOME $HOME/.local/share
set -gx XDG_STATE_HOME $HOME/.local/state
[ $(uname) = Linux ] && set -gx XDG_RUNTIME_DIR /run/user/$EUID

set -gx ANDROID_HOME $XDG_DATA_HOME/android
set -gx BUNDLE_USER_CONFIG $XDG_CONFIG_HOME/bundle
set -gx BUNDLE_USER_CACHE $XDG_CACHE_HOME/bundle
set -gx BUNDLE_USER_PLUGIN $XDG_DATA_HOME/bundle
set -gx CARGO_HOME $XDG_DATA_HOME/cargo
set -gx CONDARC $XDG_CONFIG_HOME/conda/condarc
set -gx COPILOT_HOME $XDG_CONFIG_HOME/copilot
set -gx CUDA_CACHE_PATH $XDG_CACHE_HOME/nv
set -gx DENO_INSTALL_ROOT $HOME/.local/bin
set -gx DOCKER_CONFIG $XDG_CONFIG_HOME/docker
set -gx DOTNET_CLI_HOME $XDG_DATA_HOME/dotnet
set -gx EDITOR nvim
set -gx ELM_HOME $XDG_CONFIG_HOME/elm
set -gx GNUPGHOME $XDG_DATA_HOME/gnupg
set -gx GEM_SPEC_CACHE $XDG_CACHE_HOME/gem
set -gx GRADLE_USER_HOME $XDG_DATA_HOME/gradle
set -gx IPYTHONDIR $XDG_CONFIG_HOME/ipython
contains $XDG_DATA_HOME/julia (string split : $JULIAUP_DEPOT_PATH) ||
    set -gxp --path JULIA_DEPOT_PATH $XDG_DATA_HOME/julia
set -gx JULIAUP_DEPOT_PATH $JULIA_DEPOT_PATH
set -gx JULIA_PKG_SERVER https://mirrors.nju.edu.cn/julia
set -gx JUPYTER_CONFIG_DIR $XDG_CONFIG_HOME/jupyter
set -gx LESSHISTFILE $XDG_CACHE_HOME/less/history
set -gx MINIKUBE_HOME $XDG_DATA_HOME/minikube
set -gx NVM_DIR $XDG_DATA_HOME/nvm
set -gx NODE_REPL_HISTORY $XDG_DATA_HOME/node_repl_history
set -gx NPM_CONFIG_USERCONFIG $XDG_CONFIG_HOME/npm/npmrc
set -gx GOPATH $XDG_DATA_HOME/go
set -gx PASSWORD_STORE_DIR $XDG_DATA_HOME/pass
set -gx PSQL_HISTORY $XDG_DATA_HOME/psql_history
set -gx PYTHONSTARTUP $XDG_CONFIG_HOME/python/pythonrc
set -gx PYTHON_HISTORY $XDG_STATE_HOME/python_history
set -gx RANDFILE $XDG_STATE_HOME/openssl/rnd
set -gx RIPGREP_CONFIG_PATH $XDG_CONFIG_HOME/ripgrep/config
set -gx RUSTUP_HOME $XDG_DATA_HOME/rustup
set -gx rvm_path $XDG_DATA_HOME/rvm
set -gx SQLITE_HISTORY $XDG_CACHE_HOME/sqlite_history
set -gx TERMINFO $XDG_DATA_HOME/terminfo
set -gx TERMINFO_DIRS $XDG_DATA_HOME/terminfo:/usr/share/terminfo
set -gx TEXMFVAR $XDG_CACHE_HOME/texlive/texmf-var
set -gx VAGRANT_HOME $XDG_DATA_HOME/vagrant
set -gx WAKATIME_HOME $XDG_CONFIG_HOME/wakatime
set -gx WGETRC $XDG_CONFIG_HOME/wgetrc
set -gx W3M_DIR $XDG_DATA_HOME/w3m
set -gx ZSH $XDG_DATA_HOME/oh-my-zsh
