# XDG base directories
set -x XDG_CONFIG_HOME $HOME/.config
set -x XDG_CACHE_HOME $HOME/.cache
set -x XDG_DATA_HOME $HOME/.local/share
set -x XDG_STATE_HOME $HOME/.local/state
[ $(uname) = Linux ] && set -x XDG_RUNTIME_DIR /run/user/$EUID

set -x ANDROID_HOME $XDG_DATA_HOME/android
set -x BUNDLE_USER_CONFIG $XDG_CONFIG_HOME/bundle
set -x BUNDLE_USER_CACHE $XDG_CACHE_HOME/bundle
set -x BUNDLE_USER_PLUGIN $XDG_DATA_HOME/bundle
set -x CARGO_HOME $XDG_DATA_HOME/cargo
set -x CONDARC $XDG_CONFIG_HOME/conda/condarc
set -x COPILOT_HOME $XDG_CONFIG_HOME/copilot
set -x CUDA_CACHE_PATH $XDG_CACHE_HOME/nv
set -x DENO_INSTALL_ROOT $HOME/.local/bin
set -x DOCKER_CONFIG $XDG_CONFIG_HOME/docker
set -x DOTNET_CLI_HOME $XDG_DATA_HOME/dotnet
set -x EDITOR nvim
set -x ELM_HOME $XDG_CONFIG_HOME/elm
set -x GNUPGHOME $XDG_DATA_HOME/gnupg
set -x GEM_SPEC_CACHE $XDG_CACHE_HOME/gem
set -x GRADLE_USER_HOME $XDG_DATA_HOME/gradle
set -x IPYTHONDIR $XDG_CONFIG_HOME/ipython
contains $XDG_DATA_HOME/julia $JULIAUP_DEPOT_PATH ||
    set -xp --path JULIA_DEPOT_PATH $XDG_DATA_HOME/julia
set -x JULIAUP_DEPOT_PATH $JULIA_DEPOT_PATH
set -x JULIA_PKG_SERVER https://mirrors.nju.edu.cn/julia
set -x JUPYTER_CONFIG_DIR $XDG_CONFIG_HOME/jupyter
set -x LESSHISTFILE $XDG_CACHE_HOME/less/history
set -x MINIKUBE_HOME $XDG_DATA_HOME/minikube
set -x NVM_DIR $XDG_DATA_HOME/nvm
set -x NODE_REPL_HISTORY $XDG_DATA_HOME/node_repl_history
set -x NPM_CONFIG_USERCONFIG $XDG_CONFIG_HOME/npm/npmrc
set -x GOPATH $XDG_DATA_HOME/go
set -x PASSWORD_STORE_DIR $XDG_DATA_HOME/pass
set -x PSQL_HISTORY $XDG_DATA_HOME/psql_history
set -x PYTHONSTARTUP $XDG_CONFIG_HOME/python/pythonrc
set -x PYTHON_HISTORY $XDG_STATE_HOME/python_history
set -x RANDFILE $XDG_STATE_HOME/openssl/rnd
set -x RIPGREP_CONFIG_PATH $XDG_CONFIG_HOME/ripgrep/config
set -x RUSTUP_HOME $XDG_DATA_HOME/rustup
set -x rvm_path $XDG_DATA_HOME/rvm
set -x SQLITE_HISTORY $XDG_CACHE_HOME/sqlite_history
set -x TERMINFO $XDG_DATA_HOME/terminfo
set -x TERMINFO_DIRS $XDG_DATA_HOME/terminfo:/usr/share/terminfo
set -x TEXMFVAR $XDG_CACHE_HOME/texlive/texmf-var
set -x VAGRANT_HOME $XDG_DATA_HOME/vagrant
set -x WAKATIME_HOME $XDG_CONFIG_HOME/wakatime
set -x WGETRC $XDG_CONFIG_HOME/wgetrc
set -x W3M_DIR $XDG_DATA_HOME/w3m
set -x ZSH $XDG_DATA_HOME/oh-my-zsh
