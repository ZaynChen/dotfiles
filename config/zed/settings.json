// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "theme": {
    "mode": "light",
    "light": "One Light",
    "dark": "One Dark",
  },
  "icon_theme": "Zed (Default)",
  "base_keymap": "Zed",
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "buffer_font_fallbacks": [".ZedMono", "WenQuanYi Zen Hei Mono"],
  "buffer_font_size": 16,
  "buffer_font_weight": 500,
  "ui_font_family": "FiraCode Nerd Font",
  "ui_font_fallbacks": [".ZedSans", "WenQuanYi Zen Hei"],
  "ui_font_size": 16,
  "ui_font_weight": 500,
  "vim_mode": true,
  "cli_default_open_behavior": "existing_window",
  "colorize_brackets": true,
  "auto_signature_help": true,
  "wrap_guides": [80, 120],
  "show_whitespaces": "trailing",
  "whitespace_map": { "space": "⋅", "tab": "→" },
  "toolbar": {
    "code_actions": true,
  },
  "minimap": { "show": "never" },
  "indent_guides": {
    "coloring": "indent_aware",
    "background_coloring": "indent_aware",
  },
  "relative_line_numbers": "enabled",
  "use_smartcase_search": true,
  "inlay_hints": {
    "enabled": true,
    "show_background": true,
  },
  "project_panel": {
    "hide_gitignore": true,
  },
  "collaboration_panel": { "dock": "left" },
  "git_panel": { "tree_view": true },
  "tabs": {
    "git_status": true,
    "file_icons": true,
  },
  "format_on_save": "on",
  "tab_size": 2,
  "diagnostics": {
    "inline": { "enabled": true, "max_severity": "warning" },
  },
  "file_scan_exclusions": [
    // "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.sl",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
  ],
  "git": {
    "inline_blame": { "show_commit_summary": true },
  },
  "terminal": {
    "env": {},
    "line_height": "comfortable",
    "toolbar": { "breadcrumbs": true },
    "font_family": "FiraCode Nerd Font Mono",
    "font_fallbacks": [".ZedMono", "WenQuanYi Zen Hei Mono"],
  },
  "file_types": { "Hyprland Config": ["hypr*.conf"] },
  "languages": {
    "Python": { "language_servers": ["ty", "ruff"], "tab_size": 4 },
    "Rust": { "tab_size": 4 },
    "Julia": { "tab_size": 4 },
    "Fish": {
      "tab_size": 4,
      "formatter": { "external": { "command": "fish_indent" } },
    },
    // "JavaScript": { "language_servers": ["deno"] },
    // "TypeScript": { "language_servers": ["deno"] },
    // "TSX": { "language_servers": ["deno"] },
  },
  "session": { "trust_all_worktrees": true },
  "lsp": {
    "ruff": {
      "initialization_options": {
        "settings": {},
      },
    },
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy", // rust-analyzer.check.command (default: "check")
        },
      },
    },
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "keyOrdering": false, // Enforces alphabetical ordering of keys in maps
        },
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "inlayHints": {
            "parameterNames": {
              "enabled": "all",
              "suppressWhenArgumentMatchesName": false,
            },
            "parameterTypes": { "enabled": false },
            "variableTypes": {
              "enabled": false,
              "suppressWhenTypeMatchesName": true,
            },
            "propertyDeclarationTypes": { "enabled": true },
            "functionLikeReturnTypes": { "enabled": true },
            "enumMemberValues": { "enabled": true },
          },
        },
      },
    },
  },
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true,
  },
  "which_key": { "enabled": true },
  "proxy": "http://127.0.0.1:7893",
}
